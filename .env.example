# Cadena de conexión a PostgreSQL.
# Copiar este archivo a .env y reemplazar los valores reales.
# .env NO se versiona: está en .gitignore y el .htaccess lo bloquea.
#
# ---------- CONEXIÓN REMOTA: NEON ----------
# Usar la conexión DIRECTA del endpoint, no la que pasa por el pooler.
# El host va sin usuario ni clave en la ruta; todo va en la URL.
DATABASE_URL="postgresql://thimpson_app:REEMPLAZAR_CLAVE@ep-xxxxxxxx-xxxxxxx.us-east-1.aws.neon.tech/thimpsonexpress?sslmode=require"
#
# ---------- CONEXIÓN LOCAL: RESPALDO ----------
# No se configura acá: si falta .env o DATABASE_URL queda vacía, el código usa
#   postgresql://postgres@127.0.0.1:5432/thimpsonexpress?sslmode=disable
