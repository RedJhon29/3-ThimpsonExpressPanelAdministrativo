Thumbs.db

# IDE
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Screenshots
screenshots/

# Temp
*.tmp
*.temp

# Imágenes subidas por los usuarios: son contenido de runtime y no se
# versionan. Viven en Publico/Recursos/uploads/ porque es la única
# carpeta estática que el .htaccess raíz deja servir.
#
# Se versionan dos cosas de ahí: default/ con la imagen por defecto
# (sin ella el alta de un registro sin foto falla en un clon nuevo) y
# el .htaccess que impide ejecutar scripts dentro de la carpeta.
# El asterisco delante del directorio es necesario: sin él, git no
# puede re-incluir nada dentro de una carpeta excluida.
Publico/Recursos/uploads/*
!Publico/Recursos/uploads/default/
!Publico/Recursos/uploads/.htaccess

# Herramienta de pruebas E2E
.playwright-mcp/
