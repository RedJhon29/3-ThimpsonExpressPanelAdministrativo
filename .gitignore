# Node modules
node_modules/

# Dist
dist/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Screenshots
screenshots/

# Temp
*.tmp
*.temp

# Fotos de usuarios: son contenido de runtime, no se versionan.
# default/ si se versiona porque es un asset del proyecto: sin esa imagen
# el alta de un usuario sin foto no tiene con que copiar. El asterisco
# delante del directorio es necesario: sin el, git no puede re-incluir
# nada dentro de una carpeta excluida.
Publico/Recursos/uploads/usuarios/*
!Publico/Recursos/uploads/usuarios/default/

# Herramienta de pruebas E2E
.playwright-mcp/
